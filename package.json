{
  "name": "darkmark",
  "displayName": "darkmark",
  "publisher": "n1th1n-19",
  "description": "Dark-themed viewers for Markdown, spreadsheets, Word, PowerPoint, PDF and images, plus an interactive Git client, in VS Code and VSCodium",
  "version": "3.1.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/n1th1n-19/DARKMARK"
  },
  "icon": "media/logo.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "darkmark.preview",
        "displayName": "darkmark",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "darkmark.sheet",
        "displayName": "darkmark Sheet",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.ods"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "darkmark.csv",
        "displayName": "darkmark Sheet",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "darkmark.docx",
        "displayName": "darkmark Word",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "darkmark.pdf",
        "displayName": "darkmark PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "darkmark.slides",
        "displayName": "darkmark Slides",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "darkmark.image",
        "displayName": "darkmark Image",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.avif"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "darkmark.openAsText",
        "title": "darkmark: Edit Source"
      },
      {
        "command": "darkmark.git.open",
        "title": "darkmark: Git",
        "icon": "$(git-merge)"
      },
      {
        "command": "darkmark.git.fileHistory",
        "title": "darkmark: File History"
      },
      {
        "command": "darkmark.git.blame",
        "title": "darkmark: Blame"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "darkmark.git.fileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "darkmark@1"
        },
        {
          "command": "darkmark.git.blame",
          "when": "!explorerResourceIsFolder",
          "group": "darkmark@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "darkmark.git.fileHistory",
          "when": "resourceScheme == file",
          "group": "darkmark@1"
        },
        {
          "command": "darkmark.git.blame",
          "when": "resourceScheme == file",
          "group": "darkmark@2"
        }
      ],
      "editor/context": [
        {
          "command": "darkmark.git.fileHistory",
          "when": "resourceScheme == file",
          "group": "darkmark@1"
        },
        {
          "command": "darkmark.git.blame",
          "when": "resourceScheme == file",
          "group": "darkmark@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p ./tsconfig.webview.json",
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "esbuild csv=src/webview/lib/csv.ts log=src/git/log.ts graph=src/git/graph.ts diff=src/git/diff.ts status=src/git/status.ts rebase=src/git/rebase.ts gitrun=src/git/runner.ts git-editor=src/git/editor.ts --bundle --platform=node --format=esm --log-level=warning --outdir=.test-out --out-extension:.js=.mjs && node --test test/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.10",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.1",
    "markdown-it": "^14.0.0",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
